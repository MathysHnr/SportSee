# Copier ce fichier vers `.env` puis adapter les valeurs si besoin.

# `true`  : l'application utilise les données mockées (aucun backend requis)
# `false` : l'application interroge l'API SportSee
VITE_USE_MOCK=true

# URL de base de l'API SportSee (utilisée quand VITE_USE_MOCK=false)
VITE_API_URL=http://localhost:3000
